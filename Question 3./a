// 16-bit PPA
module PPA(A,B,Cin,S,Cout);

input [15:0] A,B;
input Cin;

output[15:0] S;
output Cout;

//propagation and generation logic
wire[15:0] P,G;

genvar i;

//for loop
generate
  for(i=0;i<16;i+=1) begin
    or (P[i], A[i], B[i]);
    and (G[i], A[i], B[i]);
  end
endgenerate

//prefix computation block
wire [15:0] P1,G1;
wire [15:0] P2,G2;
wire [15:0] P3,G3;
wire [15:0] P4,G4;

genvar j;
generate
  for(j=0;j<16;j+=1) begin
    if(j % 2 == 1) begin
      wire temp;
      and (P1[j], P[j],P[j-1]);
      and (temp, P[j],G[j-1]);
      or (G1[j], G[j],temp);
    end
    else begin
      assign P1[j] = P[j];
      assign G1[j] = G[j];
    end
  end
endgenerate


endmodule
