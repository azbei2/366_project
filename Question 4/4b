`timescale 1ns/1ps
module tb_KS;

reg  [15:0] A, B;
reg         Cin;
wire [15:0] S;
wire        Cout;
wire signed [15:0] S_signed = S;

KS dut (A, B, Cin, S, Cout);

initial begin
    $dumpfile("dump.vcd");
    $dumpvars(0, tb_KS);
    $monitor("A=%h B=%h Cin=%b -> S=%h Cout=%b | unsigned %0d, signed %0d",
             A, B, Cin, S, Cout, S, S_signed);

//test
    A=16'd10;    B=16'd5;      Cin = 0; #10; //unsign add
    A=16'hFFFF;  B=16'd1;      Cin = 0; #10; //carryout
    A=-16'sd10;  B=16'd5;      Cin = 0; #10; //signed add
    A=16'h00FF;  B=16'h0001;   Cin = 0; #10; //carry
    A=16'd10;    B=16'd5;      Cin = 1; #10; //cin = 1
    A=16'd25;    B=16'd15;     Cin = 0; #10; //unsigned add
    A=16'd25;    B=~16'd15;    Cin = 1; #10; //unsigned sub
    A=16'd20;    B=~(-16'd15); Cin = 1; #10; //signed sub
    $finish;
end

endmodule
