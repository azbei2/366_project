module four_bit_RCA_RCS ( A, B, Cin, S, Cout);

input [3:0] A, B;
input Cin;
output [3:0] S;
output Cout;

wire [3:0] Bm;
wire c1, c2, c3;

xor inv0 (Bm[0], B[0], Cin);
xor inv1 (Bm[1], B[1], Cin);
xor inv2 (Bm[2], B[2], Cin);
xor inv3 (Bm[3], B[3], Cin);

one_bit_full_adder fa0 (A[0], Bm[0], Cin, S[0], c1);
one_bit_full_adder fa1 (A[1], Bm[1], c1,  S[1], c2);
one_bit_full_adder fa2 (A[2], Bm[2], c2,  S[2], c3);
one_bit_full_adder fa3 (A[3], Bm[3], c3,  S[3], Cout);

endmodule
