// ECE 366 Progress report 1d

module four_bit_RCA_RCS ( A, B, Cin, S, Cout);

input [3:0] A, B;
input Cin;
output [3:0] S;
output Cout;

wire [3:0] Binv;
wire c1, c2, c3;

not inv0 (Binv[0], B[0]);
not inv1 (Binv[1], B[1]);
not inv2 (Binv[2], B[2]);
not inv3 (Binv[3], B[3]);

one_bit_full_adder fa0 (A[0], Binv[0], Cin, S[0], c1);
one_bit_full_adder fa1 (A[1], Binv[1], c1,  S[1], c2);
one_bit_full_adder fa2 (A[2], Binv[2], c2,  S[2], c3);
one_bit_full_adder fa3 (A[3], Binv[3], c3,  S[3], Cout);

endmodule
